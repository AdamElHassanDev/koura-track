+    piezas = [p for k in scene.pieces if k[0] == "calzada" and k[2] for p in scene.pieces[k]
+              if id(p) not in aparte and len(p.faces)]
+    if not piezas:
+        return
+    off = np.cumsum([0] + [len(p.pos) for p in piezas])
+    P = np.concatenate([p.pos for p in piezas]).astype(np.float64)
+    z0 = P[:, 2].copy()
+    z = z0.copy()
+    arbol = cKDTree(P[:, :2])
+    K = 160
+    R = 2.5 * sigma
+    for _ in range(pasadas):
