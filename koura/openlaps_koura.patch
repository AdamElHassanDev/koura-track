+    g = coo_matrix((np.ones(len(pares), np.int8), (pares[:, 0], pares[:, 1])), shape=(len(P), len(P)))
+    _, inv = connected_components(g, directed=False)
+    n = int(inv.max()) + 1
+    cnt = np.bincount(inv, minlength=n)
+    zs = np.bincount(inv, weights=P[:, 2], minlength=n) / np.maximum(cnt, 1)
+    zmin = np.full(n, np.inf); zmax = np.full(n, -np.inf)
+    np.minimum.at(zmin, inv, P[:, 2]); np.maximum.at(zmax, inv, P[:, 2])
+    mismo = (zmax - zmin) <= 1.0            # further apart: two levels (a ramp beside an avenue), not a step
+    Z = np.where(mismo, zs, np.nan)[inv]
+    Z = np.where(np.isfinite(Z), Z, P[:, 2])
+    soldados = int(((zmax - zmin > 0.02) & mismo).sum())
+    Fw = inv[F]                              # faces on welded ids
+    XY = np.zeros((n, 2)); XY[inv] = P[:, :2]
+    Zw = np.zeros(n); Zw[inv] = Z            # welded z (for two-level places: one of them; they are not touched)
+    libre = mismo.copy()
+    e = np.concatenate([Fw[:, [0, 1]], Fw[:, [1, 2]], Fw[:, [2, 0]]])
+    e = e[e[:, 0] != e[:, 1]]
+    tocados = np.zeros(n, bool)
+    for _ in range(pasadas):
+        a, b, c = XY[Fw[:, 0]], XY[Fw[:, 1]], XY[Fw[:, 2]]
+        za, zb, zc = Zw[Fw[:, 0]], Zw[Fw[:, 1]], Zw[Fw[:, 2]]
+        ux, uy, uz = b[:, 0] - a[:, 0], b[:, 1] - a[:, 1], zb - za
+        vx, vy, vz = c[:, 0] - a[:, 0], c[:, 1] - a[:, 1], zc - za
+        nx_, ny_, nz_ = uy * vz - uz * vy, uz * vx - ux * vz, ux * vy - uy * vx
+        with np.errstate(invalid="ignore", divide="ignore"):
+            pen = np.hypot(nx_, ny_) / np.abs(nz_)
