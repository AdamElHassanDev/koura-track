+XYZ_SOURCES = {
+    # Esri World Imagery: personal use only in this project (never redistributed)
+    "lb_xyz": ("https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}", 18),
+}
+
+
+class XYZRaster:
+    """Aerial imagery from XYZ tiles, decoded on demand (one array for a 12 km rectangle would not fit in memory).
+    Same `sample` interface as Raster. Tiles are cached on disk under CACHE_DIR/xyz/<source>/z/x/y.jpg."""
+
+    def __init__(self, source, log=print, cache_tiles=400, zoom=None):
+        from collections import OrderedDict
+        self.url, self.z = XYZ_SOURCES[source]
+        if zoom is not None:
+            self.z = zoom
+        self.source = source
+        self.log = log
+        self.n = 2 ** self.z
+        self.ok = self.failed = 0
+        self._mem = OrderedDict()
+        self._max = cache_tiles
+        self._tr = {}
+
+    def tile_path(self, x, y):
+        from .cache import CACHE_DIR
+        d = os.path.join(CACHE_DIR, "xyz", self.source, str(self.z), str(x))
+        os.makedirs(d, exist_ok=True)
+        return os.path.join(d, f"{y}.jpg")
+
+    def fetch_tile(self, x, y):
+        """Downloads one tile to disk if missing. Returns the path or None."""
+        import urllib.request
+        p = self.tile_path(x, y)
+        if os.path.exists(p) and os.path.getsize(p) > 0:
+            return p
+        for attempt in range(3):
+            try:
+                req = urllib.request.Request(self.url.format(z=self.z, x=x, y=y), headers={"User-Agent": "Mozilla/5.0"})
+                with urllib.request.urlopen(req, timeout=40) as r:
+                    b = r.read()
+                if len(b) < 200:
+                    raise ValueError("empty tile")
+                with open(p + ".part", "wb") as f:
+                    f.write(b)
+                os.replace(p + ".part", p)
+                return p
+            except Exception:  # noqa: BLE001
+                time.sleep(1.5 * (attempt + 1))
+        return None
+
+    def _tile(self, x, y):
+        from PIL import Image
+        k = (x, y)
+        if k in self._mem:
+            self._mem.move_to_end(k)
+            return self._mem[k]
+        p = self.fetch_tile(x, y)
+        a = None
+        if p:
+            try:
+                a = np.asarray(Image.open(p).convert("RGB"))
+                self.ok += 1
+            except Exception:  # noqa: BLE001
+                a = None
+        if a is None:
+            self.failed += 1
+            a = np.zeros((256, 256, 3), np.uint8)
+        self._mem[k] = a
+        if len(self._mem) > self._max:
+            self._mem.popitem(last=False)
+        return a
+
+    def tiles_for_lonlat(self, lon, lat):
+        """Global pixel coordinates (float) at this zoom for lon/lat arrays."""
+        lat = np.clip(np.asarray(lat, float), -85.0, 85.0)
+        px = (np.asarray(lon, float) + 180.0) / 360.0 * self.n * 256.0
+        py = (1.0 - np.arcsinh(np.tan(np.radians(lat))) / math.pi) / 2.0 * self.n * 256.0
+        return px, py
+
+    def sample(self, proj, x, y, order=1, mode="nearest"):
+        x = np.asarray(x, float)
+        y = np.asarray(y, float)
+        lon, lat = _transformar(_transformer(proj.epsg, "EPSG:4326"), x.ravel() + proj.ox, y.ravel() + proj.oy)
+        px, py = self.tiles_for_lonlat(lon, lat)
+        if not len(px):
+            return np.zeros(x.shape + (3,), np.float32)
+        tx0, tx1 = int(px.min() // 256), int(px.max() // 256)
+        ty0, ty1 = int(py.min() // 256), int(py.max() // 256)
+        if (tx1 - tx0 + 1) * (ty1 - ty0 + 1) > 900:      # absurd request: do not mosaic half the planet
+            return np.zeros(x.shape + (3,), np.float32)
+        mos = np.zeros(((ty1 - ty0 + 1) * 256, (tx1 - tx0 + 1) * 256, 3), np.uint8)
+        for ty in range(ty0, ty1 + 1):
+            for tx in range(tx0, tx1 + 1):
+                mos[(ty - ty0) * 256:(ty - ty0 + 1) * 256, (tx - tx0) * 256:(tx - tx0 + 1) * 256] = self._tile(tx, ty)
+        coords = np.vstack([py - ty0 * 256 - 0.5, px - tx0 * 256 - 0.5])
+        return np.stack([map_coordinates(mos[..., b], coords, order=min(order, 1), mode="nearest", output=np.float32).reshape(x.shape)
+                         for b in range(3)], -1)
+
+    def resumen(self):
