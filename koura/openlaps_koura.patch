+"""Static background terrain on the same grid as the detailed Koura ground."""
+
+from collections import defaultdict
+from collections.abc import Callable
+from dataclasses import dataclass
+from functools import lru_cache
+
+import numpy as np
+import shapely
+
+from . import textures
+from .terrain import _atlas_bounds, _terrain_uv, fisica_del_suelo
+
+
+@dataclass(frozen=True)
+class Coverage:
+    detailed: shapely.Geometry
+    background: shapely.Geometry
+    height: Callable
+
+    @property
+    def outline(self):
+        return self.detailed.union(self.background)
+
+    @property
+    def seam(self):
+        return self.detailed.boundary.intersection(self.background.boundary)
+
+
+def _tiles(terrain, zone, tile_step):
+    """Select whole background tiles and exclude every existing detailed tile."""
+    detailed = {}
+    for i0, _, j0, _, bounds, _ in terrain._tiles(tile_step, ()):
+        detailed[i0 // tile_step, j0 // tile_step] = shapely.box(*bounds)
+
+    shapely.prepare(zone)
+    background = {}
+    for j0 in range(0, len(terrain.gy) - 1, tile_step):
+        j1 = min(j0 + tile_step, len(terrain.gy) - 1)
+        for i0 in range(0, len(terrain.gx) - 1, tile_step):
+            key = (i0 // tile_step, j0 // tile_step)
+            if key in detailed:
+                continue
+            i1 = min(i0 + tile_step, len(terrain.gx) - 1)
+            footprint = shapely.box(terrain.gx[i0], terrain.gy[j0], terrain.gx[i1], terrain.gy[j1])
+            if zone.intersects(footprint) and not zone.touches(footprint):
+                background[key] = (i0, i1, j0, j1, footprint)
+    return detailed, background
+
+
+@lru_cache(maxsize=24)
+def _grid(width, height, stride):
+    """Triangulate a coarse interior and keep the full native grid around the rim."""
+    xs = [*range(0, width, stride), width]
+    ys = [*range(0, height, stride), height]
+    vertices = {}
+    faces = []
+    offsets = [0]
+
+    def index(point):
+        return vertices.setdefault(point, len(vertices))
+
+    for bottom, top in zip(ys, ys[1:]):
+        for left, right in zip(xs, xs[1:]):
+            a, b, c, d = (left, bottom), (right, bottom), (right, top), (left, top)
+            # A fan gives each native segment its own triangle. In particular it
+            # cannot bridge over a steep vertex on a neighboring detailed edge.
+            rim = [a]
+            if bottom == 0:
+                rim.extend((x, bottom) for x in range(left + 1, right))
+            rim.append(b)
+            if right == width:
+                rim.extend((right, y) for y in range(bottom + 1, top))
+            rim.append(c)
+            if top == height:
+                rim.extend((x, top) for x in range(right - 1, left, -1))
+            rim.append(d)
+            if left == 0:
+                rim.extend((left, y) for y in range(top - 1, bottom, -1))
+            if len(rim) == 4:
+                ai, bi, ci, di = map(index, rim)
+                faces.extend(((ai, bi, ci), (ai, ci, di)))
+            else:
+                center = index(((left + right) / 2, (bottom + top) / 2))
+                ring = list(map(index, rim))
+                faces.extend((center, start, end) for start, end in zip(ring, ring[1:] + ring[:1]))
+            offsets.append(len(faces))
+
+    return np.array(list(vertices), dtype=float), np.asarray(faces, dtype=np.int64), np.array(offsets)
+
+
+def _grid_vertices(terrain, i0, i1, j0, j1, nodes):
+    ix, iy = nodes.T
+    low_x, low_y = ix.astype(int), iy.astype(int)
+    frac_x, frac_y = ix - low_x, iy - low_y
+    ix0, iy0 = i0 + low_x, j0 + low_y
+    ix1, iy1 = np.minimum(i1, ix0 + 1), np.minimum(j1, iy0 + 1)
+    x = terrain.gx[ix0] + frac_x * (terrain.gx[ix1] - terrain.gx[ix0])
+    y = terrain.gy[iy0] + frac_y * (terrain.gy[iy1] - terrain.gy[iy0])
+    z = terrain.Z[iy0, ix0]
+    mid = (frac_x > 0) | (frac_y > 0)
+    z[mid] = terrain.z_plano(terrain.Z, x[mid], y[mid])
+    return np.column_stack([x, y, z]), (ix0, ix1, iy0, iy1, mid)
+
+
+def _ground_mesh(terrain, i0, i1, j0, j1, stride):
+    nodes, faces, _ = _grid(i1 - i0, j1 - j0, stride)
+    pos, (ix0, ix1, iy0, iy1, mid) = _grid_vertices(terrain, i0, i1, j0, j1, nodes)
+
+    # Match the detailed vertex normals without allocating another full-map array.
+    bx, ex = max(0, i0 - 1), min(len(terrain.gx), i1 + 2)
+    by, ey = max(0, j0 - 1), min(len(terrain.gy), j1 + 2)
+    dy, dx = np.gradient(terrain.Z[by:ey, bx:ex], terrain.gy[by:ey], terrain.gx[bx:ex])
+    slope_x = dx[iy0 - by, ix0 - bx]
+    slope_y = dy[iy0 - by, ix0 - bx]
+    slope_x[mid] = (slope_x[mid] + dx[iy1[mid] - by, ix1[mid] - bx]) / 2
+    slope_y[mid] = (slope_y[mid] + dy[iy1[mid] - by, ix1[mid] - bx]) / 2
+    normals = np.column_stack([-slope_x, -slope_y, np.ones(len(pos))])
+    normals /= np.linalg.norm(normals, axis=1, keepdims=True)
+
+    if stride == 1:
+        removed = terrain.hole[iy0, ix0][faces].any(axis=1)
+        if hasattr(terrain, "quitar1"):
+            first = terrain.quitar1[j0:j1, i0:i1].ravel()
+            second = terrain.quitar2[j0:j1, i0:i1].ravel()
+            removed[::2] |= first
+            removed[1::2] |= second
+        faces = faces[~removed]
+    return pos, normals, faces
+
+
+def _tile_heights(terrain, tile, stride, x, y):
+    i0, i1, j0, j1, _ = tile
+    nx, ny = i1 - i0, j1 - j0
+    nodes, faces, offsets = _grid(nx, ny, stride)
+    pos, _ = _grid_vertices(terrain, i0, i1, j0, j1, nodes)
+    columns, rows = (nx + stride - 1) // stride, (ny + stride - 1) // stride
+    # Convert to a coarse cell, including the final partial cell at the tile edge.
+    col = np.floor((x - terrain.gx[i0]) / ((terrain.gx[i1] - terrain.gx[i0]) / nx * stride)).astype(int)
+    row = np.floor((y - terrain.gy[j0]) / ((terrain.gy[j1] - terrain.gy[j0]) / ny * stride)).astype(int)
+    cell = np.clip(row, 0, rows - 1) * columns + np.clip(col, 0, columns - 1)
+    per_cell = np.diff(offsets).max()
+    face_ids = np.minimum(offsets[cell, None] + np.arange(per_cell), offsets[cell + 1, None] - 1)
+    a, b, c = pos[faces[face_ids]].transpose(2, 0, 1, 3)
+    ab, ac = b - a, c - a
+    qx, qy = x[:, None] - a[..., 0], y[:, None] - a[..., 1]
+    area = ab[..., 0] * ac[..., 1] - ab[..., 1] * ac[..., 0]
+    u = (qx * ac[..., 1] - qy * ac[..., 0]) / area
+    v = (ab[..., 0] * qy - ab[..., 1] * qx) / area
+    inside = (u >= -1e-7) & (v >= -1e-7) & (u + v <= 1 + 1e-7)
+    return np.max(np.where(inside, a[..., 2] + u * ab[..., 2] + v * ac[..., 2], -np.inf), axis=1)
+
+
+def _background_height(terrain, background, native_tiles, tile_step, stride):
+    def height(x, y):
+        x, y = np.broadcast_arrays(np.asarray(x, float), np.asarray(y, float))
+        result = terrain.z_plano(terrain.Z, x, y)
+        if not x.size or not background:
+            return result
+        cols = np.searchsorted(terrain.gx[:-1:tile_step], x.ravel(), side="right") - 1
+        rows = np.searchsorted(terrain.gy[:-1:tile_step], y.ravel(), side="right") - 1
+        order = np.lexsort((cols, rows))
+        change = np.flatnonzero((np.diff(cols[order]) != 0) | (np.diff(rows[order]) != 0)) + 1
+        flat = result.reshape(-1)
+        xs, ys = x.ravel(), y.ravel()
+        for group in np.split(order, change):
+            key = (cols[group[0]], rows[group[0]])
+            if key in background and key not in native_tiles:
+                values = _tile_heights(terrain, background[key], stride, xs[group], ys[group])
+                hits = np.isfinite(values)
+                flat[group[hits]] = values[hits]
+        return result
+
+    return height
+
+
+def _tile_patches(terrain, selected, tile_step):
+    """Index reconstructed ditch and tunnel faces by the same tile as their cuts."""
+    result = defaultdict(list)
+    xedges, yedges = terrain.gx[:-1:tile_step], terrain.gy[:-1:tile_step]
+    columns = len(xedges)
+    for pos, faces in getattr(terrain, "parches", ()):
+        if not len(faces):
+            continue
+        center = pos[faces, :2].mean(axis=1)
+        col = np.searchsorted(xedges, center[:, 0], side="right") - 1
+        row = np.searchsorted(yedges, center[:, 1], side="right") - 1
+        inside = ((col >= 0) & (row >= 0) & (center[:, 0] <= terrain.gx[-1])
+                  & (center[:, 1] <= terrain.gy[-1]))
+        ids = row[inside] * columns + col[inside]
+        sorted_indices = np.argsort(ids, kind="stable")
+        boundaries = np.r_[0, np.flatnonzero(np.diff(ids[sorted_indices])) + 1, len(ids)]
+        face_indices = np.flatnonzero(inside)[sorted_indices]
+        for start, end in zip(boundaries, boundaries[1:]):
+            if start == end:
+                continue
+            y, x = divmod(int(ids[sorted_indices[start]]), columns)
+            if (x, y) in selected:
+                result[x, y].append((pos, faces[face_indices[start:end]]))
+    return result
+
+
+def _needs_native(terrain, i0, i1, j0, j1):
+    if terrain.hole[j0:j1 + 1, i0:i1 + 1].any():
+        return True
+    return hasattr(terrain, "quitar1") and (
+        terrain.quitar1[j0:j1, i0:i1].any() or terrain.quitar2[j0:j1, i0:i1].any())
+
+
+def _add_faces(scene, name, tile, pos, uv, normals, faces, physics):
+    used, remap = np.unique(faces.ravel(), return_inverse=True)
+    scene.add("suelo_fondo", name, pos[used], uv[used], remap.reshape(-1, 3),
+              normals=normals[used] if normals is not None else None, phys=physics, tile=tile)
+
+
+def add_background(scene, terrain, painter, background_zone, *, tile_m=128., mesh_m=8.,
+                   mpp=1., cobertura=None, road_union=None, log=print):
+    """Build background outside emitted detailed tiles. Return actual coverage and the shared edge."""
+    tile_step = max(1, round(tile_m / terrain.res))
+    # Use an integral stride so the coarse grid shares exact coordinates with the native mesh.
+    spacing = max(terrain.gx[1] - terrain.gx[0], terrain.gy[1] - terrain.gy[0])
+    stride = max(1, int((mesh_m + 1e-6) / spacing))
+    detailed, background = _tiles(terrain, background_zone, tile_step)
+    native_tiles = set()
+    coverage = Coverage(shapely.coverage_union_all(list(detailed.values())),
+                        shapely.coverage_union_all([tile[4] for tile in background.values()]),
+                        _background_height(terrain, background, native_tiles, tile_step, stride))
+    if not background:
+        return coverage
+
+    atlases = defaultdict(list)
+    for (col, row), tile in background.items():
+        atlases[col // 4, row // 4].append(((col, row), tile))
+    patches = _tile_patches(terrain, background, tile_step)
+    if road_union is not None:
+        shapely.prepare(road_union)
+
+    triangle_count = 0
+    for key, tiles in atlases.items():
+        bounds = shapely.total_bounds([tile[4] for _, tile in tiles])
+        west, south, east, north = atlas_bounds = _atlas_bounds(bounds, mpp)
+        image = painter.paint_tile(west, south, east, north, mpp, terrain)
+        name = f"suelo_fondo_b{key[0]}_{key[1]}"
+        texture = f"{name}.png"
+        scene.textures[texture] = textures.png(image)
+        scene.images[texture] = image
+        scene.material(name, texture, specular=0, ambient=0.4, diffuse=0.36, spec_exp=5.,
+                       shadows=False)
+        for tile_key, (i0, i1, j0, j1, footprint) in tiles:
+            native = (tile_key in patches or _needs_native(terrain, i0, i1, j0, j1)
+                      or (road_union is not None and road_union.intersects(footprint)))
+            if native:
+                native_tiles.add(tile_key)
+            pos, normals, faces = _ground_mesh(terrain, i0, i1, j0, j1, 1 if native else stride)
+            uv = _terrain_uv(pos, atlas_bounds)
+            # For the background, share dry-ground physics across each atlas. Preserve water.
+            groups = defaultdict(list)
+            for physics, triangles in fisica_del_suelo(pos, faces, cobertura):
+                groups["WATER" if physics == "WATER" else "GRASS"].append(triangles)
+                triangle_count += len(triangles)
+            for physics, triangles in groups.items():
+                _add_faces(scene, name, key, pos, uv, normals, np.concatenate(triangles), physics)
+            for patch_pos, patch_faces in patches.get(tile_key, ()):
+                used, remap = np.unique(patch_faces.ravel(), return_inverse=True)
+                patch = patch_pos[used]
+                patch_faces = remap.reshape(-1, 3)
+                tri = patch[patch_faces]
+                reverse = np.cross(tri[:, 1] - tri[:, 0], tri[:, 2] - tri[:, 0])[:, 2] < 0
+                patch_faces[reverse] = patch_faces[reverse, ::-1]
+                scene.add("suelo_fondo", name, patch, _terrain_uv(patch, atlas_bounds), patch_faces,
+                          phys="GRASS", tile=key)
+                triangle_count += len(patch_faces)
+            x0, y0, x1, y1 = footprint.bounds
+            crop = ((x0 - west) / mpp, (north - y1) / mpp, (x1 - west) / mpp, (north - y0) / mpp)
+            terrain.tiles.append((x0, y0, x1, y1, image, crop))
+
+    log(f"  background ground: {coverage.background.area / 1e6:.2f} km², "
+        f"{len(background)} tiles ({len(native_tiles)} at native resolution), {len(atlases)} atlases, "
+        f"{triangle_count:,} triangles, {stride * spacing:.2f} m grid, {mpp:g} m/px")
+    return coverage
