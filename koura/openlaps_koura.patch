+        if reference == "auto" and footprint.covers(point):
+            base = float(sample(xy)[0])
+    orientation = Rotation.from_euler("z", -heading, degrees=True)
+    positioned = [(mat, orientation.apply(pos) + (x, y, base), uv, faces) for mat, pos, uv, faces in parts]
+    footprint = shapely.MultiPoint(np.concatenate([pos[:, :2] for _, pos, _, _ in positioned])).convex_hull
+    if not zone.covers(footprint):
