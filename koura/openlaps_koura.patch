+def alisar_picos(scene, pend=0.28, pasadas=40, log=print):
+    """Koura: last pass over the drivable road surface. The owner felt sharp bumps and sudden dips, mostly at
+    junctions: pieces that meet with a step, and a few triangles standing almost vertical (300-400 % slope).
+    1. vertices of different pieces at the same place (5 cm) with 2-100 cm between them are welded to their mean;
+    2. vertices of triangles steeper than `pend` are relaxed towards the mean of their neighbours, repeatedly.
+    Bridges and tunnels (scene.aparte) are left alone."""
+    aparte = getattr(scene, "aparte", set())
+    piezas = [p for k in scene.pieces if k[0] == "calzada" and k[2] for p in scene.pieces[k]
+              if id(p) not in aparte and len(p.faces)]
+    if not piezas:
+        return
+    off = np.cumsum([0] + [len(p.pos) for p in piezas])
+    P = np.concatenate([p.pos for p in piezas]).astype(np.float64)
