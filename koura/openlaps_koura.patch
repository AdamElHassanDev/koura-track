+def suavizar_rodadura(scene, sigma=None, tope=0.6, pasadas=3, log=print):
+    """Koura: irons the drivable road surface. Each road vertex takes the height of the plane that best fits the
+    road around it (gaussian weights, `sigma` m), so a constant grade or a banked curve is left exactly as it is
+    and only waves shorter than a few car lengths go. Pieces that meet at the same place get the same height.
+    Neighbours more than 0.6 m above or below are another road (a terrace, a ramp) and do not count. Bridges and
+    tunnels are left alone. No vertex moves more than `tope` m."""
