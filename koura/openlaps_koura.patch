@@ -0,0 +1,277 @@
+"""Background crowns located from aerial imagery and the canopy height model."""
+
+import json
+import math
+from pathlib import Path
+
+import numpy as np
+import shapely
+from scipy.ndimage import gaussian_filter, maximum_filter
+from scipy.spatial import cKDTree
+
+from . import config
+
+
+WINDOW_M = 384
+PIXEL_M = 0.8
+MARGIN_M = 16
+PLOT_M = 300
+SPECIES = ("olivo", "encino", "pino")
+
+
+def _pix_grid(west, south, side, step):
+    offset = (np.arange(round(side / step)) + 0.5) * step
+    return np.meshgrid(west + offset, south + offset)
+
+
+def _crown_peaks(rgb, heights):
+    """Find crown-scale contrast and chromatic peaks with optional height support."""
+    optical = np.zeros(heights.shape, dtype=bool)
+    valid = optical.copy()
+    image_support = optical.copy()
+    leaf_colour = optical.copy()
+    score = np.zeros(heights.shape, dtype=np.float32)
+    if rgb is not None:
+        red, green, blue = rgb.transpose(2, 0, 1)
+        luma = 0.25 * red + 0.55 * green + 0.20 * blue
+        valid = luma > 4
+        surround = gaussian_filter(luma, 4.3)
+        center = gaussian_filter(luma, 1.55)
+        light = np.maximum(surround, 35)
+        darkness = (surround - center) / light
+        chroma = (green - 0.60 * red - 0.40 * blue) / np.maximum(luma, 35)
+        green_center = gaussian_filter(chroma, 1.55)
+        green_surround = gaussian_filter(chroma, 4.3)
+        hue_contrast = green_center - green_surround
+        score = darkness + 0.9 * hue_contrast
+        image_support = valid & (green_center > 0.038)
+        # An uncorroborated grove needs distinct foliage, not merely dark compact spots
+        # against light rock. Both the absolute green and its local contrast matter.
+        leaf_colour = valid & (green_center >= 0.145) & (hue_contrast >= 0.014)
+        optical = valid & (green_center > 0.050) & (score > 0.075)
+        optical &= (darkness > 0.044) | (hue_contrast > 0.039)
+
+    canopy = gaussian_filter(np.maximum(heights, 0), 1.15)
+    crown_shape = (canopy - gaussian_filter(canopy, 4.3)) > 0.38
+    fused = image_support & (canopy > 1.30) & (score > 0.024)
+    optical |= fused
+    score += 0.018 * np.minimum(canopy / 4.0, 1.0)
+    # Break exact ties on quantized, flat crown tops without changing measured contrast.
+    pixel_order = np.arange(score.size).reshape(score.shape) * (1e-10 / score.size)
+    supported_score = np.where(optical, score + pixel_order, -np.inf)
+    photo_peaks = optical & (supported_score == maximum_filter(supported_score, size=7))
+    # An optical-only crown needs curvature in both directions. Terrace edges are often dark
+    # and green as well, but their response is elongated along the wall or furrow.
+    photo_peaks[:2] = photo_peaks[-2:] = False
+    photo_peaks[:, :2] = photo_peaks[:, -2:] = False
+    py, px = np.nonzero(photo_peaks & (canopy < 1.30))
+    xx = 2 * score[py, px] - score[py, px - 2] - score[py, px + 2]
+    yy = 2 * score[py, px] - score[py - 2, px] - score[py + 2, px]
+    xy = (score[py - 2, px + 2] + score[py + 2, px - 2] -
+          score[py - 2, px - 2] - score[py + 2, px + 2]) * 0.25
+    trace = xx + yy
+    spread = np.hypot(xx - yy, 2 * xy)
+    photo_peaks[py, px] = (trace > 0.025) & (trace - spread >= 0.26 * (trace + spread))
+    # A distinct canopy crown also supplies a position in dense vegetation or a missing photo tile.
+    canopy_context = image_support | ~valid
+    canopy_peaks = (canopy > 1.4) & crown_shape & canopy_context
+    height_order = canopy + pixel_order
+    canopy_peaks &= height_order == maximum_filter(height_order, size=7)
+    canopy_peaks &= ~maximum_filter(photo_peaks, size=7)
+    rows, cols = np.nonzero(photo_peaks | canopy_peaks)
+    return rows, cols, canopy[rows, cols], photo_peaks[rows, cols], valid[rows, cols], leaf_colour[rows, cols]
+
+
+def _row_members(points):
+    """Require two consecutive, similarly spaced and aligned crown triplets."""
+    if len(points) < 4:
+        return np.zeros(len(points), dtype=bool)
+    distances, indices = cKDTree(points).query(points, k=min(10, len(points)), distance_upper_bound=15)
+    recent = (distances >= 3.7) & np.isfinite(distances)
+    nearby = np.minimum(indices, len(points) - 1)
+    offsets = points[nearby] - points[:, None]
+    unit = offsets / np.where(recent, distances, 1)[..., None]
+    dot = unit @ unit.transpose(0, 2, 1)
+    along = dot < -0.982
+    lower = np.where(recent, distances, 0.0)
+    along &= recent[:, :, None] & recent[:, None, :]
+    along &= (lower[:, :, None] <= lower[:, None, :] * 1.26)
+    along &= (lower[:, None, :] <= lower[:, :, None] * 1.26)
+    center = np.arange(len(points))[:, None, None]
+    continues = (along.any(axis=2)[nearby] & (indices[nearby] == center)).any(axis=2)
+    confirmed = along & (continues[:, :, None] | continues[:, None, :])
+    members = confirmed.any(axis=(1, 2))
+    members[indices[confirmed.any(axis=2)]] = True
+    return members
+
+
+def _identify(crowns, model_height, image_peaks, valid_photo, land, orchard, leaf_colour):
+    farm = land == config.WC_CROP
+    wood = land == config.WC_TREE
+    open_cover = farm | (land == config.WC_GRASS) | (land == config.WC_SHRUB)
+    row = np.zeros(len(crowns), dtype=bool)
+    # Tall woodland and unsupported rocky peaks cannot supply neighbours in a planted row.
+    supported = orchard | farm | leaf_colour | (model_height >= 1.3)
+    orchard_candidates = image_peaks & (model_height < 6.8) & supported
+    row[orchard_candidates] = _row_members(crowns[orchard_candidates])
+    recognised_grove = orchard | row | farm
+    olive = recognised_grove & (model_height < 6.8)
+    olive |= wood & (1.4 <= model_height) & (model_height < 3.7) & image_peaks
+
+    # Grass, dry terraces and crop furrows do not carry an isolated optical tree without canopy support.
+    verified = (model_height >= 1.3) | (image_peaks & (row | orchard))
+    verified |= image_peaks & wood & (model_height >= 0.7)
+    verified &= land != config.WC_WATER
+    verified &= open_cover | wood | orchard | (model_height > 3.8)
+    species = np.where(olive, 0, np.where(model_height >= 8.5, 2, 1))
+    scaled = np.where(olive, model_height * 1.28, model_height * 1.08)
+    heights = np.clip(scaled, np.take([2.6, 3.3, 7.0], species),
+                      np.take([7.0, 13.0, 16.0], species))
+    sources = np.where(image_peaks, np.where(model_height >= 1.3, 1, 0),
+                       np.where(valid_photo, 1, 2))
+    return verified, species, heights, row & olive, sources
+
+
+def _emit(scene, kind, points, ground, heights, rng, tile):
+    """Crossed, double-sided alpha-test cards, using one existing material per species."""
+    count = len(points)
+    width = heights * {"olivo": 1.32, "encino": 0.87, "pino": 0.62}[kind]
+    yaw = rng.uniform(0, np.pi, count)
+    low = ground - 0.15
+    high = ground + heights
+    positions = np.empty((count, 4, 4, 3), dtype=np.float32)
+    coords = np.array([[0, 1], [1, 1], [1, 0], [0, 0]], dtype=np.float32)
+    for index, angle in enumerate((yaw, yaw + np.pi / 2)):
+        half_axis = np.column_stack([np.cos(angle), np.sin(angle)]) * width[:, None] / 2
+        left, right = points - half_axis, points + half_axis
+        for side, (start, end) in enumerate(((left, right), (right, left))):
+            face = positions[:, 2 * index + side]
+            face[:, :, :2] = np.stack([start, end, end, start], axis=1)
+            face[:, :, 2] = np.column_stack([low, low, high, high])
+    quad = np.array([[0, 1, 2], [0, 2, 3]])
+    offsets = np.arange(4 * count).reshape(-1, 1, 1) * 4
+    faces = (offsets + quad).reshape(-1, 3)
+    uv = np.broadcast_to(coords, (count, 4, 4, 2))
+    scene.add("arboles_fondo", f"veg_{kind}_0", positions.reshape(-1, 3),
+              uv.reshape(-1, 2), faces, tile=tile)
+
+
+def _plot_evidence(folder, windows, ortho, proj):
+    """Save north-up source plates and crown locations to match against the exported GLB."""
+    from PIL import Image, ImageDraw
+
+    folder = Path(folder)
+    folder.mkdir(parents=True, exist_ok=True)
+    catalog = []
+    locations = list(windows)
+    while locations and len(catalog) < 10:
+        def priority(item):
+            x, y, points, kinds, rows, covered, inside = item
+            diversity = len(np.unique(kinds))
+            distance = min((math.hypot(x - old["x"], y - old["y"]) for old in catalog), default=2000)
+            return (int(len(catalog) < 6 and inside >= 0.5), int(distance >= 600), covered * min(distance, 2400) *
+                    (math.sqrt(len(points)) + np.count_nonzero(rows) / max(len(points), 1) + diversity))
+
+        choice = max(range(len(locations)), key=lambda i: priority(locations[i]))
+        cx, cy, points, kinds, rows, covered, inside = locations.pop(choice)
+        west, south = cx - PLOT_M / 2, cy - PLOT_M / 2
+        gx, gy = _pix_grid(west, south, PLOT_M, 0.5)
+        rgb = ortho.sample(proj, gx, gy, order=1)
+        source = Image.fromarray(np.clip(rgb[::-1], 0, 255).astype(np.uint8))
+        overlay = source.copy()
+        draw = ImageDraw.Draw(overlay)
+        colors = ("#e8c753", "#74dc9a", "#73bcf0")
+        for (x, y), kind in zip(points, kinds):
+            px, py = 2 * (x - west), 2 * (south + PLOT_M - y)
+            draw.ellipse((px - 2, py - 2, px + 2, py + 2), outline=colors[kind], width=1)
+        name = f"grove-{len(catalog) + 1:02d}"
+        source.save(folder / f"{name}-source.png")
+        overlay.save(folder / f"{name}-crowns.png")
+        lon, lat = proj.to_lonlat(cx, cy)
+        catalog.append({
+            "name": name, "x": cx, "y": cy, "lon": float(lon), "lat": float(lat), "side_m": PLOT_M,
+            "counts": dict(zip(SPECIES, map(int, np.bincount(kinds, minlength=3)))),
+            "olive_row_members": int(rows.sum()),
+            "background_share": round(covered, 3),
+            "inside_loop_share": round(inside, 3),
+        })
+    (folder / "plots.json").write_text(json.dumps(catalog, indent=2) + "\n")
+    return len(catalog)
+
+
+def build(scene, terrain, zone, *, ortho, chm, landcover=None, exclude=None, orchard=None,
+          distant=None, distant_density=1.0, ground_height=None, inside_loop=None, evidence_dir=None, log=print):
+    """Add nonphysical background foliage, preserving the sampled crown positions."""
+    if not 0 < distant_density <= 1:
+        raise ValueError("Background distant tree density must be in (0, 1]")
+    counts = np.zeros(3, dtype=int)
+    data_counts = np.zeros(3, dtype=int)
+    window_count = row_count = missing_ground = 0
+    windows = []
+    surface_height = terrain.height if ground_height is None else ground_height
+    if not zone.is_empty and (ortho is not None or chm is not None):
+        proj = terrain.proj
+        xmin, ymin, xmax, ymax = zone.bounds
+        for iy in range(math.floor(ymin / WINDOW_M), math.ceil(ymax / WINDOW_M)):
+            for ix in range(math.floor(xmin / WINDOW_M), math.ceil(xmax / WINDOW_M)):
+                west, south = ix * WINDOW_M, iy * WINDOW_M
+                east, north = west + WINDOW_M, south + WINDOW_M
+                if not zone.intersects(shapely.box(west, south, east, north)):
+                    continue
+                window_count += 1
+                gx, gy = _pix_grid(west - MARGIN_M, south - MARGIN_M, WINDOW_M + 2 * MARGIN_M, PIXEL_M)
+                rgb = ortho.sample(proj, gx, gy, order=1) if ortho is not None else None
+                canopy = chm.sample(proj, gx, gy, order=1) if chm is not None else np.zeros(gx.shape, np.float32)
+                canopy = np.nan_to_num(canopy, nan=0, posinf=0, neginf=0)
+                r, c, model_height, image_peaks, valid_photo, leaf_colour = _crown_peaks(rgb, canopy)
+                if len(r) == 0:
+                    continue
+                x, y = gx[r, c], gy[r, c]
+                permitted = ~shapely.intersects_xy(exclude, x, y) if exclude is not None else np.ones(x.size, bool)
+                x, y = x[permitted], y[permitted]
+                points = np.column_stack((x, y))
+                land = (landcover.sample(proj, x, y, order=0).astype(int)
+                        if landcover is not None and len(x) else np.full(len(x), config.WC_GRASS))
+                old_grove = shapely.contains_xy(orchard, x, y) if orchard is not None else np.zeros(x.size, bool)
+                keep, kinds, heights, rows, sources = _identify(
+                    points, model_height[permitted], image_peaks[permitted], valid_photo[permitted],
+                    land, old_grove, leaf_colour[permitted])
+                keep &= (x >= west) & (x < east) & (y >= south) & (y < north) & shapely.contains_xy(zone, x, y)
+                rng = np.random.default_rng([ix % 2**32, iy % 2**32])
+                if distant is not None and distant_density < 1:
+                    keep &= ~shapely.contains_xy(distant, x, y) | (rng.random(len(x)) < distant_density)
+                if not keep.any():
+                    continue
+                ground = surface_height(*points[keep].T)
+                finite = np.isfinite(ground)
+                missing_ground += int(np.count_nonzero(~finite))
+                keep[keep] = finite
+                points, kinds, heights, rows = points[keep], kinds[keep], heights[keep], rows[keep]
+                ground = ground[finite]
+                if not keep.any():
+                    continue
+                counts += np.bincount(kinds, minlength=3)
+                data_counts += np.bincount(sources[keep], minlength=3)
+                row_count += int(rows.sum())
+                for code, kind in enumerate(SPECIES):
+                    where = kinds == code
+                    if where.any():
+                        _emit(scene, kind, points[where], ground[where], heights[where], rng, (ix // 2, iy // 2))
+                if evidence_dir is not None and ortho is not None:
+                    cx, cy = west + WINDOW_M / 2, south + WINDOW_M / 2
+                    plot = (np.abs(points - [cx, cy]) < PLOT_M / 2).all(axis=1)
+                    if plot.sum() >= 8:
+                        half = PLOT_M / 2
+                        footprint = shapely.box(cx - half, cy - half, cx + half, cy + half)
+                        covered = zone.intersection(footprint).area / PLOT_M**2
+                        inside = inside_loop.intersection(footprint).area / PLOT_M**2 if inside_loop is not None else 0.0
+                        windows.append((cx, cy, points[plot], kinds[plot], rows[plot], covered, inside))
+    stats = {
+        "species": dict(zip(SPECIES, map(int, counts))),
+        "sources": dict(zip(("aerial_crown", "aerial_and_canopy", "canopy_without_aerial"), map(int, data_counts))),
+        "olive_row_members": row_count, "windows": window_count, "unplaced_without_ground": missing_ground,
+    }
+    if evidence_dir is not None and ortho is not None and windows:
+        stats["plots"] = _plot_evidence(evidence_dir, windows, ortho, terrain.proj)
+    log("  background trees: " + json.dumps(stats, ensure_ascii=False, sort_keys=True))
+    return stats
