@@ -0,0 +1,312 @@
+"""Footprint, roof, facade and sign overrides for the baked Koura stages."""
+
+import hashlib
+import io
+import json
+import math
+import re
+from collections import Counter
+from pathlib import Path
+
+import numpy as np
+import shapely
+from PIL import Image, ImageDraw, ImageOps
+from shapely.geometry import LineString, Point, Polygon
+from shapely.geometry.polygon import orient
+
+from . import config, textures
+
+
+TAG_FIELDS = {
+    "levels": "building:levels",
+    "roof": "roof:shape",
+    "colour": "building:colour",
+    "roof_colour": "roof:colour",
+}
+ROOFS = {"flat", "gabled", "hipped", "pyramidal", "half-hipped", "mansard", "gambrel"}
+METADATA = {"name", "source", "state", "note"}
+MATCH_DISTANCE_M = 3.0
+
+
+def _keys(entry, allowed):
+    if not isinstance(entry, dict):
+        raise ValueError("expected an object")
+    unknown = entry.keys() - allowed
+    if unknown:
+        raise ValueError(f"unknown fields: {', '.join(sorted(unknown))}")
+
+
+def _number(value):
+    return isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value)
+
+
+def _local(proj, lat, lon):
+    if not _number(lat) or not _number(lon) or not (-90 <= lat <= 90 and -180 <= lon <= 180):
+        raise ValueError("expected valid latitude and longitude")
+    x, y = proj.to_local(lon, lat)
+    if not (math.isfinite(x) and math.isfinite(y)):
+        raise ValueError("coordinate does not project to a finite location")
+    return float(x), float(y)
+
+
+def _osm_id(value):
+    if not isinstance(value, str) or not re.fullmatch(r"[wr][0-9]+", value):
+        raise ValueError("expected an OSM area id such as w123 or r123")
+    return value
+
+
+def _image(directory, value):
+    if not isinstance(value, str) or not value.strip():
+        raise ValueError("expected an image path relative to the override file")
+    path = (directory / value).resolve()
+    if Path(value).is_absolute() or not path.is_relative_to(directory):
+        raise ValueError("image path must stay within the override directory")
+    if not path.is_file():
+        raise ValueError(f"image missing: {value}")
+    with Image.open(path) as image:
+        image.verify()
+    return path
+
+
+def _wall_index(value, outline):
+    if type(value) is not int or not 0 <= value < len(outline) - 1:
+        raise ValueError(f"edge must be an integer from 0 to {len(outline) - 2}")
+    edge = outline[value:value + 2]
+    if edge[0] == edge[1]:
+        raise ValueError("edge has zero length")
+    return tuple(edge)
+
+
+def _details(building, entry, directory):
+    """Validate the entire entry before replacing any fields on the building."""
+    tags = dict(building["tags"])
+    updates = {}
+    for key, tag in TAG_FIELDS.items():
+        if key not in entry:
+            continue
+        value = entry[key]
+        if key == "levels":
+            if type(value) is not int or value <= 0 or not math.isfinite(value * config.LEVEL_HEIGHT):
+                raise ValueError("levels must be a positive integer")
+            # The explicit override takes precedence over a source height.
+            tags.pop("height", None)
+            updates["floors"] = value
+        elif key == "roof":
+            if not isinstance(value, str) or value not in ROOFS:
+                raise ValueError(f"unsupported roof shape: {value!r}")
+        elif not isinstance(value, str) or textures.parse_colour(value) is None:
+            raise ValueError(f"invalid {key}: {value!r}")
+        tags[tag] = str(value)
+    name = entry.get("name")
+    if name is not None:
+        if not isinstance(name, str) or not name.strip():
+            raise ValueError("name must be a non-empty string")
+        tags["name"] = name
+
+    outline = building.get("wall_outline")
+    if outline is None and ("facades" in entry or "sign" in entry):
+        outline = tuple(orient(building["poly"], 1.0).exterior.coords)
+    walls = {edge: dict(detail) for edge, detail in building.get("wall_details", {}).items()}
+    if "facades" in entry:
+        if not isinstance(entry["facades"], list):
+            raise ValueError("facades must be a list")
+        seen = set()
+        for facade in entry["facades"]:
+            _keys(facade, {"edge", "image", "fit"})
+            edge = _wall_index(facade.get("edge"), outline)
+            fit = facade.get("fit", "tile")
+            if fit not in ("tile", "stretch"):
+                raise ValueError("facade fit must be tile or stretch")
+            if edge in seen:
+                raise ValueError("multiple facades target the same edge")
+            seen.add(edge)
+            walls.setdefault(edge, {}).update(photo=_image(directory, facade.get("image")), fit=fit)
+
+    if "sign" in entry:
+        sign = entry["sign"]
+        _keys(sign, {"edge", "text", "image"})
+        edge = _wall_index(sign.get("edge"), outline)
+        text = sign.get("text")
+        if text is not None and (not isinstance(text, str) or not text.strip()):
+            raise ValueError("sign text must be a non-empty string")
+        detail = walls.setdefault(edge, {})
+        if "image" in sign:
+            if "photo" in detail:
+                raise ValueError("a facade image and a shopfront image target the same edge")
+            detail.update(photo=_image(directory, sign["image"]), fit="stretch")
+        elif text:
+            detail["text"] = text
+        else:
+            raise ValueError("sign requires text or an image")
+
+    return {**building, **updates, "tags": tags, "wall_outline": outline, "wall_details": walls}
+
+
+def _footprint(entry, proj):
+    ring = entry.get("ring")
+    if not isinstance(ring, list) or len(ring) < 3:
+        raise ValueError("ring must contain at least three latitude/longitude pairs")
+    points = []
+    for pair in ring:
+        if not isinstance(pair, list) or len(pair) != 2:
+            raise ValueError("ring vertices must be [latitude, longitude]")
+        points.append(_local(proj, *pair))
+    poly = Polygon(points)
+    if not poly.is_valid or poly.area < 6 or any(a == b for a, b in zip(points, points[1:])):
+        raise ValueError("ring must be a valid footprint of at least 6 m² with no consecutive duplicates")
+    return {"poly": poly, "tags": {"building": "yes"}, "height": None, "src": "manual",
+            "wall_outline": tuple(poly.exterior.coords)}
+
+
+def _counted(log, counts, label, operation):
+    try:
+        result = operation()
+    except (ValueError, OSError, OverflowError, Image.DecompressionBombError) as error:
+        counts["rejected"] += 1
+        log(f"  building override {label}: rejected ({error})")
+        return
+    if result:
+        counts["applied"] += 1
+    else:
+        counts["unmatched"] += 1
+        log(f"  building override {label}: unmatched")
+
+
+def apply(buildings, path, proj, clip, log):
+    """Apply a local JSON file without mutating source tags or footprints."""
+    path = Path(path).resolve()
+    counts = Counter()
+
+    def summary():
+        log(f"  building overrides: {counts['applied']} applied, {counts['unmatched']} unmatched, "
+            f"{counts['rejected']} rejected")
+
+    try:
+        data = json.loads(path.read_text(encoding="utf-8"))
+        _keys(data, {"by_osm_id", "by_point", "add", "remove"})
+        if not isinstance(data.get("by_osm_id", {}), dict):
+            raise ValueError("by_osm_id must be an object")
+        for optional_list in ("by_point", "add", "remove"):
+            if not isinstance(data.get(optional_list, []), list):
+                raise ValueError(f"{optional_list} must be a list")
+    except (OSError, ValueError) as error:
+        log(f"  building overrides: rejected {path.name} ({error})")
+        counts["rejected"] += 1
+        summary()
+        return buildings
+    if not any(data.values()):
+        summary()
+        return buildings
+
+    items = list(buildings)
+    polys = [item["poly"] for item in items]
+    point_index = shapely.STRtree(polys)
+    by_id = {}
+    for k, item in enumerate(items):
+        if item.get("osm_id") is not None:
+            by_id.setdefault(item["osm_id"], []).append(k)
+    removed = set()
+    editable = set(TAG_FIELDS) | METADATA | {"facades", "sign"}
+
+    def find_point(entry):
+        point = Point(_local(proj, entry.get("lat"), entry.get("lon")))
+        choices = [int(k) for k in point_index.query(point, predicate="dwithin", distance=MATCH_DISTANCE_M)
+                   if k not in removed]
+        if not choices:
+            return ()
+        return (min(choices, key=lambda k: (polys[k].distance(point), polys[k].area, k)),)
+
+    def remove(entry):
+        _keys(entry, {"osm_id", "lat", "lon"} | METADATA)
+        if "osm_id" in entry:
+            if "lat" in entry or "lon" in entry:
+                raise ValueError("specify either osm_id or coordinates")
+            matches = set(by_id.get(_osm_id(entry["osm_id"]), ())) - removed
+        else:
+            matches = find_point(entry)
+        removed.update(matches)
+        return bool(matches)
+
+    def update(entry, matches):
+        if len(matches) > 1 and ("facades" in entry or "sign" in entry):
+            raise ValueError("the OSM id has multiple footprints; use by_point for a wall-specific edit")
+        updated = [_details(items[k], entry, path.parent) for k in matches]
+        for k, replacement in zip(matches, updated):
+            items[k] = replacement
+        return bool(updated)
+
+    def update_id(osm_id, entry):
+        _keys(entry, editable)
+        matches = [k for k in by_id.get(_osm_id(osm_id), []) if k not in removed]
+        return update(entry, matches)
+
+    def update_point(entry):
+        _keys(entry, editable | {"lat", "lon"})
+        return update(entry, find_point(entry))
+
+    def add(entry):
+        _keys(entry, editable | {"ring"})
+        b = _footprint(entry, proj)
+        if not clip.contains(b["poly"].centroid):
+            return False
+        items.append(_details(b, entry, path.parent))
+        return True
+
+    for k, entry in enumerate(data.get("remove", [])):
+        _counted(log, counts, f"remove[{k}]", lambda: remove(entry))
+    for osm_id, entry in data.get("by_osm_id", {}).items():
+        _counted(log, counts, f"by_osm_id[{osm_id}]", lambda: update_id(osm_id, entry))
+    for k, entry in enumerate(data.get("by_point", [])):
+        _counted(log, counts, f"by_point[{k}]", lambda: update_point(entry))
+    for k, entry in enumerate(data.get("add", [])):
+        _counted(log, counts, f"add[{k}]", lambda: add(entry))
+
+    summary()
+    return [b for k, b in enumerate(items) if k not in removed]
+
+
+def _material(scene, name, image):
+    texture = name + ".png"
+    scene.textures[texture] = textures.png(image)
+    scene.images[texture] = image
+    return scene.material(name, texture, ambient=0.5, diffuse=0.55, specular=0.04)
+
+
+def photo_material(scene, path):
+    content = path.read_bytes()
+    name = "fachada_foto_" + hashlib.sha256(content).hexdigest()[:16]
+    if name not in scene.materials:
+        with Image.open(io.BytesIO(content)) as raw:
+            image = ImageOps.exif_transpose(raw).convert("RGB")
+        image.thumbnail((2048, 2048), Image.Resampling.LANCZOS)
+        _material(scene, name, image)
+    return name
+
+
+def sign_material(scene, text):
+    name = "fachada_rotulo_" + hashlib.sha256(text.encode()).hexdigest()[:16]
+    if name not in scene.materials:
+        image = Image.new("RGB", (512, 96), (48, 52, 52))
+        draw = ImageDraw.Draw(image)
+        draw.rectangle((3, 3, 508, 92), outline=(167, 158, 133), width=2)
+        size = 56
+        font = textures._font(size)
+        while size > 8 and draw.textlength(text, font=font) > 472:
+            size -= 2
+            font = textures._font(size)
+        draw.text((256, 48), text, fill=(243, 234, 217), font=font, anchor="mm")
+        _material(scene, name, image)
+    return name
+
+
+def wall_match(points, walls):
+    """Map a built edge onto the authored wall, including a clipped wall segment."""
+    for edge, detail in walls.items():
+        line = LineString(edge)
+        if not all(line.distance(Point(pt)) < 1e-5 for pt in points):
+            continue
+        start, end = (line.project(Point(pt), normalized=True) for pt in points)
+        if end < start:
+            start, end = 1.0 - start, 1.0 - end
+        return edge, detail, np.array([start, end])
+    return None
