+    return footprint
+
+
+def build(scene, proj, terrain, rect, zone, directory=None, *, log=print):
+    """Build walls, junction islands, and landmarks after the road mesh and terrain are final.
+
+    Entries have a source, a stable ID and a state. `todo` reserves a row for review.
+    Wall gate gaps are distances measured along the surveyed line from its start.
+    Landmark meshes use dimensions relative to a terrain or island placement point.
+    """
+    if directory is None:
+        return []
+    directory = Path(directory)
+    area = box(*rect) if zone is None else zone.intersection(box(*rect))
+    exclusions, islands, applied_landmarks = [], [], set()
+    stock = [(pieces, piece) for (group, _, _), pieces in scene.pieces.items()
+             if group == "isleta" for piece in pieces]
+    road_surface = None
+    for kind in ("walls", "junctions", "landmarks"):
+        path = directory / f"{kind}.json"
+        try:
+            entries = _load(path)
+        except (OSError, ValueError) as exc:
+            log(f"  overrides {kind}: invalid file: {exc}")
+            continue
+        applied = outside = pending = invalid = 0
+        metres = 0.0
+        seen = set()
+        for number, entry in enumerate(entries, 1):
+            try:
+                _entry(entry, seen)
+                if entry["state"] == "todo":
+                    pending += 1
+                    continue
+                if kind == "walls":
+                    pieces, length = _wall(scene, terrain, proj, area, entry)
+                    metres += length
+                elif kind == "junctions":
+                    if road_surface is None:
+                        road_surface = _RoadSurface(scene)
+                    built = _islands(scene, terrain, proj, area, road_surface, stock, entry)
+                    islands.extend(built)
+                    pieces = [polygon for polygon, _, _ in built]
+                else:
+                    if entry.get("anchor") == "road" and road_surface is None:
+                        road_surface = _RoadSurface(scene)
+                    landmark = _landmark(scene, terrain, proj, area, directory, entry, islands, road_surface)
+                    pieces = [] if landmark is None else [landmark]
+                    if pieces:
+                        applied_landmarks.add(entry["id"])
+                if pieces:
+                    exclusions.extend(pieces)
+                    applied += 1
+                else:
+                    outside += 1
+            except (KeyError, OSError, TypeError, ValueError, shapely.errors.GEOSException) as exc:
+                invalid += 1
+                identifier = entry.get("id", number) if isinstance(entry, dict) else number
+                log(f"  overrides {kind}: rejected {identifier}: {exc}")
+        unmatched = sorted({name for _, _, content in islands for name in content} - applied_landmarks)
+        if kind == "landmarks" and unmatched:
+            log(f"  overrides landmarks: island content unmatched: {', '.join(unmatched)}")
+        length = f", {metres:.1f} m" if kind == "walls" else ""
+        log(f"  overrides {kind}: {applied} applied, {outside} outside/unmatched, {pending} pending, {invalid} invalid{length}")
+    return exclusions
