+            i1 = min(i0 + 200000, len(P))
+            d, j = arbol.query(P[i0:i1, :2], k=K, distance_upper_bound=R)
+            ok = np.isfinite(d)
+            j = np.where(ok, j, 0)
+            dz = z[j] - z[i0:i1, None]
+            w = np.exp(-0.5 * (d / sigma) ** 2, where=ok, out=np.zeros_like(d)) * (np.abs(dz) < 0.6)
+            dx = (P[j, 0] - P[i0:i1, None, 0]) * ok
+            dy = (P[j, 1] - P[i0:i1, None, 1]) * ok
+            dz = dz * ok
+            A = np.zeros((i1 - i0, 3, 3))
+            b = np.zeros((i1 - i0, 3))
