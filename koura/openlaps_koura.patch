@@ -0,0 +1,260 @@
+"""Apply Koura's plan-view road edits to the parsed OSM snapshot."""
+
+import json
+import math
+import re
+from collections import Counter, defaultdict
+from pathlib import Path
+
+import numpy as np
+from scipy.spatial import cKDTree
+
+from . import config
+
+
+JOIN_M = 3.0
+OPERATIONS = {"add", "remove", "move"}
+METADATA = {"source", "state"}
+DIRECTIONS = {"yes", "no", "1", "0", "-1", "true", "false"}
+
+
+def _way_key(value):
+    if isinstance(value, bool) or not isinstance(value, (str, int)) or not str(value).strip():
+        raise ValueError("expected a way ID")
+    return str(value)
+
+
+def _tag_values(values):
+    if not isinstance(values, dict):
+        raise ValueError("expected an object of OSM tags")
+    tags = {}
+    for key, value in values.items():
+        if key in METADATA:
+            continue
+        if not isinstance(key, str) or not key or key in {"height", "ele", "z"}:
+            raise ValueError(f"unsupported tag {key!r}")
+        if not isinstance(value, (str, int, float, bool)) or isinstance(value, float) and not math.isfinite(value):
+            raise ValueError(f"{key} must be a finite scalar")
+        tags[key] = ("yes" if value else "no") if isinstance(value, bool) else str(value).strip()
+    if not tags:
+        raise ValueError("no OSM tags provided")
+    if "width" in tags:
+        width = re.fullmatch(r"(\d+(?:\.\d+)?)\s*(?:m)?", tags["width"])
+        if not width or not 2.5 < float(width[1]) < 40:
+            raise ValueError("width must be greater than 2.5 m and less than 40 m")
+        tags["width"] = width[1]
+    if "lanes" in tags and not re.fullmatch(r"[1-8]", tags["lanes"]):
+        raise ValueError("lanes must be an integer from 1 to 8")
+    if "oneway" in tags and tags["oneway"] not in DIRECTIONS:
+        raise ValueError("oneway must be yes, no or -1")
+    if "surface" in tags and tags["surface"] not in config.SURFACE_MAP:
+        raise ValueError(f"unsupported surface {tags['surface']!r}")
+    if "highway" in tags and tags["highway"] not in config.NETWORK | config.VEREDAS:
+        raise ValueError(f"unsupported drivable highway {tags['highway']!r}")
+    if "maxspeed" in tags:
+        speed = re.fullmatch(r"(\d+(?:\.\d+)?)\s*(mph|km/h)?", tags["maxspeed"])
+        if not speed or not 5 <= float(speed[1]) * (1.609344 if speed[2] == "mph" else 1) <= 160:
+            raise ValueError("maxspeed must be between 5 and 160 km/h")
+        tags["maxspeed"] = f"{speed[1]} mph" if speed[2] == "mph" else speed[1]
+    return tags
+
+
+def _coordinates(nodes, proj):
+    if not isinstance(nodes, list) or len(nodes) < 2:
+        raise ValueError("nodes must contain at least two [latitude, longitude] pairs")
+    coords = []
+    for position in nodes:
+        if not isinstance(position, list) or len(position) != 2 or any(
+            isinstance(value, bool) or not isinstance(value, (int, float)) for value in position
+        ):
+            raise ValueError("expected a numeric [latitude, longitude] pair")
+        lat, lon = position
+        if not -90 <= lat <= 90 or not -180 <= lon <= 180:
+            raise ValueError("coordinate outside geographic bounds")
+        if not coords or coords[-1] != (lon, lat):
+            coords.append((lon, lat))
+    if len(set(coords)) < 2:
+        raise ValueError("nodes must contain two different positions")
+    xy = np.column_stack(proj.to_local(*zip(*coords)))
+    if not np.isfinite(xy).all():
+        raise ValueError("coordinate cannot be projected")
+    return coords, xy
+
+
+def _is_road(way):
+    tags = way["tags"]
+    return (
+        tags.get("highway") in config.NETWORK
+        and not config.cerrada_a_coches(tags)
+        and tags.get("area") != "yes"
+    )
+
+
+class _RoadNodes:
+    def __init__(self, ways, nodes, proj):
+        self.owners = defaultdict(set)
+        self.coords = {}
+        self.layers = {}
+        for key, way in ways.items():
+            if not _is_road(way):
+                continue
+            self.layers[key] = way["tags"].get("layer", "0")
+            for node, position in zip(way["nodes"], way["coords"]):
+                self.owners[node].add(key)
+                self.coords[node] = position
+        self.ids = list(self.coords)
+        self.xy = np.column_stack(proj.to_local(*zip(*self.coords.values()))) if self.ids else np.empty((0, 2))
+        self.tree = cKDTree(self.xy)
+        self.by_id = dict(zip(self.ids, self.xy))
+        used_ids = (node for way in ways.values() for node in way["nodes"])
+        self.next_id = min(0, min((node["id"] for node in nodes), default=0), min(used_ids, default=0)) - 1
+        self.added = {}
+
+    def _nearest(self, point, moving, layer):
+        candidates = self.tree.query_ball_point(point, JOIN_M)
+        index = min(
+            (index for index in candidates if any(
+                owner != moving and self.layers[owner] == layer for owner in self.owners[self.ids[index]]
+            )),
+            key=lambda index: (math.dist(self.xy[index], point), self.ids[index]),
+            default=None,
+        )
+        return self.ids[index] if index is not None else None
+
+    def replacement(self, positions, proj, *, moving=None, old_nodes=(), layer="0"):
+        coords, xy = _coordinates(positions, proj)
+        snapped = {}
+        if moving is not None:
+            # Keep each original shared node on the new trace. Splitting the
+            # way at these nodes keeps adjoining streets connected.
+            for node in dict.fromkeys(old_nodes):
+                if not (self.owners.get(node, set()) - {moving}):
+                    continue
+                distances = np.linalg.norm(xy - self.by_id[node], axis=1)
+                index = int(np.argmin(distances))
+                if distances[index] > JOIN_M or index in snapped:
+                    raise ValueError(f"include shared junction node {node} within {JOIN_M:g} m")
+                snapped[index] = node
+        for index in (0, len(coords) - 1):
+            if index not in snapped:
+                node = self._nearest(xy[index], moving, layer)
+                if node is not None:
+                    snapped[index] = node
+        known_positions = {coords[index]: node for index, node in snapped.items()}
+        new_nodes, new_coords = [], []
+        for index, position in enumerate(coords):
+            node = snapped.get(index, known_positions.get(position))
+            if node is not None:
+                position = self.coords[node]
+            else:
+                key = layer, position
+                node = self.added.get(key)
+                if node is None:
+                    node = self.added[key] = self.next_id
+                    self.next_id -= 1
+            if not new_nodes or new_nodes[-1] != node:
+                new_nodes.append(node)
+                new_coords.append(position)
+        if len(set(new_nodes)) < 2:
+            raise ValueError("all positions snapped to the same node")
+        return new_nodes, new_coords
+
+
+def apply_road_overrides(osm, overrides, proj, log=print):
+    """Return a parsed OSM snapshot with road overrides applied for one build."""
+    if overrides is None:
+        return osm
+    if isinstance(overrides, (str, Path)):
+        try:
+            overrides = json.loads(Path(overrides).read_text(encoding="utf-8"))
+        except (OSError, ValueError) as exc:
+            log(f"  road overrides: 0 applied, 0 unmatched, 1 rejected ({exc})")
+            return osm
+    if not isinstance(overrides, dict):
+        log("  road overrides: 0 applied, 0 unmatched, 1 rejected (expected an object)")
+        return osm
+
+    counts = Counter()
+    ways = {str(way["id"]): way for way in osm["ways"]}
+
+    def target(value):
+        key = _way_key(value)
+        if key not in ways or "highway" not in ways[key]["tags"]:
+            raise LookupError(key)
+        return key
+
+    def remove(value, _):
+        del ways[target(value)]
+
+    def set_tags(value, values):
+        key = target(value)
+        way = ways[key]
+        tags = {**way["tags"], **_tag_values(values)}
+        if tags != way["tags"]:
+            ways[key] = {**way, "tags": tags, "overridden_tags": True}
+
+    def apply(operation, entries, update):
+        for label, value in entries:
+            try:
+                update(label, value)
+            except LookupError:
+                counts["unmatched"] += 1
+                log(f"  road override {operation} {label!r}: OSM road unmatched")
+            except ValueError as exc:
+                counts["rejected"] += 1
+                log(f"  road override {operation} {label!r}: {exc}")
+            else:
+                counts["applied"] += 1
+                log(f"  road override {operation} {label!r}: applied")
+
+    def entries(key, container):
+        value = overrides.get(key, container())
+        if not isinstance(value, container):
+            counts["rejected"] += 1
+            log(f"  road override {key}: expected {container.__name__}")
+            return container()
+        return value
+
+    apply("remove", ((value, None) for value in entries("remove", list)), remove)
+    apply("tags", ((key, value) for key, value in overrides.items() if key not in OPERATIONS), set_tags)
+
+    moved = entries("move", dict)
+    added = entries("add", list)
+
+    if moved:
+        original_nodes = _RoadNodes(ways, osm["nodes"], proj)
+
+        def move(value, positions):
+            key = target(value)
+            way = ways[key]
+            if isinstance(positions, dict):
+                positions = positions.get("nodes")
+            nodes, coords = original_nodes.replacement(
+                positions, proj, moving=key, old_nodes=way["nodes"], layer=way["tags"].get("layer", "0"),
+            )
+            ways[key] = {**way, "nodes": nodes, "coords": coords}
+
+        apply("move", moved.items(), move)
+
+    if added:
+        # Snap additions against the retained and moved ways as built.
+        graph_nodes = _RoadNodes(ways, osm["nodes"], proj)
+
+        def add(_, entry):
+            if not isinstance(entry, dict):
+                raise ValueError("expected an object with id, tags and nodes")
+            key = _way_key(entry.get("id"))
+            if key in ways:
+                raise ValueError(f"way {key} already exists")
+            tags = _tag_values(entry.get("tags"))
+            if not _is_road({"tags": tags}):
+                raise ValueError("added way must be drivable")
+            nodes, coords = graph_nodes.replacement(entry.get("nodes"), proj, layer=tags.get("layer", "0"))
+            ways[key] = {"id": key, "tags": tags, "nodes": nodes, "coords": coords, "overridden_tags": True}
+
+        apply("add", ((entry.get("id") if isinstance(entry, dict) else index, entry)
+                      for index, entry in enumerate(added)), add)
+
+    log(f"  road overrides: {counts['applied']} applied, {counts['unmatched']} unmatched, "
+        f"{counts['rejected']} rejected")
+    return {**osm, "ways": list(ways.values())} if counts["applied"] else osm
