+"""Build surveyed Koura scenery from geographic coordinates and relative dimensions."""
+
+import json
+import re
+from pathlib import Path
+
+import numpy as np
+import shapely
+from PIL import Image
+from scipy.spatial.transform import Rotation
+from shapely.geometry import LineString, Point, Polygon, box
+from shapely.ops import substring
+
+from .roads import box_mesh, iter_polys, triangulate_polygon
+from .textures import png
+
+MATERIALS = {
+    "limestone": "muro_piedra", "stone": "muro_piedra", "dry_stone": "muro_piedra",
+    "concrete": "muro", "plaster": "azotea_blanco", "block": "banqueta",
+    "grass": "isleta", "metal": "defensa",
+}
+STATES = {"todo", "shape", "textured", "recheck after heights"}
+
+
+def _number(value, low, high, label):
+    if (not isinstance(value, (float, int)) or isinstance(value, bool)
+            or not low <= value <= high):
+        raise ValueError(f"{label} must be a number in [{low}, {high}]")
+    return float(value)
+
+
+def _vector(value, length, low, high, label):
+    if not isinstance(value, list) or len(value) != length:
+        raise ValueError(f"{label} must contain {length} values")
+    return np.array([_number(x, low, high, label) for x in value])
+
+
+def _xy(proj, coordinate):
+    lat, lon = _vector(coordinate, 2, -180, 180, "coordinate [lat, lon]")
+    _number(lat, -90, 90, "latitude")
+    return proj.to_local(lon, lat)
+
+
+def _material(scene, value):
+    if not isinstance(value, str) or not value:
+        raise ValueError("material is required")
+    name = MATERIALS.get(value, value)
+    if name in scene.materials:
+        return name
+    if not re.fullmatch(r"#[0-9a-fA-F]{6}", value):
+        raise ValueError(f"unknown material {value!r}")
+    name = f"landmark_{value[1:].lower()}"
+    if name not in scene.materials:
+        texture = name + ".png"
+        image = Image.new("RGB", (16, 16), value)
+        scene.images[texture] = image
+        scene.textures[texture] = png(image)
+        scene.material(name, texture, ambient=0.44, diffuse=0.52, specular=0.06)
+    return name
+
+
+def _collider(entry):
+    enabled = entry.get("collider", True)
+    if not isinstance(enabled, bool):
+        raise ValueError("collider must be true or false")
+    return "WALL" if enabled else None
+
+
+def _load(path):
+    if not path.exists():
+        return []
+    data = json.loads(path.read_text(encoding="utf-8"))
+    if not isinstance(data, list):
+        raise ValueError("expected a list of entries")
+    return data
+
+
+def _entry(entry, seen):
+    if not isinstance(entry, dict):
+        raise ValueError("entry must be an object")
+    identifier = entry.get("id")
+    if not isinstance(identifier, str) or not identifier.strip():
+        raise ValueError("id must be a nonempty string")
+    if identifier in seen:
+        raise ValueError(f"duplicate id {identifier!r}")
+    seen.add(identifier)
+    if not isinstance(entry.get("source"), str) or not entry["source"].strip():
+        raise ValueError("source is required")
+    if entry.get("state") not in STATES:
+        raise ValueError(f"state must be one of {', '.join(sorted(STATES))}")
+    if {"z", "absolute_height", "elevation", "altitude"} & entry.keys():
+        raise ValueError("use terrain-relative placement and above-ground dimensions")
+
+
+def _lines(geometry):
+    if isinstance(geometry, LineString) and geometry.length > 0.01:
+        yield geometry
+    elif hasattr(geometry, "geoms"):
+        for member in geometry.geoms:
+            yield from _lines(member)
+
+
+def _face_up(xy, faces):
+    tri = xy[faces]
+    a, b = tri[:, 1] - tri[:, 0], tri[:, 2] - tri[:, 0]
+    signed_area = a[:, 0] * b[:, 1] - a[:, 1] * b[:, 0]
+    faces = faces[signed_area != 0].copy()
+    downward = signed_area[signed_area != 0] < 0
+    faces[downward] = faces[downward, ::-1]
+    return faces
+
+
+def _wall(scene, terrain, proj, zone, entry):
+    line = LineString([_xy(proj, coord) for coord in entry["line"]])
+    if line.length < 0.1 or not line.is_simple:
+        raise ValueError("wall line is too short or self-intersecting")
+    height = _number(entry["height_m"], 0.1, 15, "height_m")
+    thickness = _number(entry.get("thickness_m", 0.35), 0.08, 3, "thickness_m")
+    material = _material(scene, entry["material"])
+    collider = _collider(entry)
+    gaps = sorted((_number(gap["start_m"], 0, line.length, "gap start_m"),
+                   _number(gap["end_m"], 0, line.length, "gap end_m"))
+                  for gap in entry.get("gaps", []))
+    segments, last = [], 0.0
+    for start, end in gaps:
+        if end <= start or start < last:
+            raise ValueError("gate gaps must have positive length and cannot overlap")
+        segments.append(substring(line, last, start))
+        last = end
+    segments.append(substring(line, last, line.length))
+
+    footprints, metres = [], 0.0
+    for segment in segments:
+        for run in _lines(segment.intersection(zone)):
+            outline = run.buffer(thickness / 2, cap_style="flat", join_style="mitre", mitre_limit=2)
+            for footprint in iter_polys(outline.intersection(zone)):
+                if footprint.area <= 1e-4:
+                    continue
+                xy, roof_faces = triangulate_polygon(footprint, 0.8)
+                top = np.column_stack([xy, terrain.height(*xy.T) + height])
+                scene.add("barreras", material, top, xy / 2, _face_up(xy, roof_faces), phys=collider)
+                orient = shapely.geometry.polygon.orient(footprint, 1.0)
+                for ring in (orient.exterior, *orient.interiors):
+                    path = np.asarray(shapely.segmentize(ring, 0.8).coords)[:, :2]
+                    grade = terrain.height(*path.T)
+                    bottom = np.column_stack([path, grade - 0.2])
+                    roof = np.column_stack([path, grade + height])
+                    count = len(path)
+                    edges = np.arange(count - 1)
+                    faces = np.vstack([np.c_[edges, edges + 1, edges + 1 + count],
+                                       np.c_[edges, edges + 1 + count, edges + count]])
+                    chainage = np.r_[0, np.cumsum(np.linalg.norm(np.diff(path, axis=0), axis=1))] / 2
+                    uv = np.vstack([np.c_[chainage, np.full(count, (height + 0.2) / 2)],
+                                    np.c_[chainage, np.zeros(count)]])
+                    scene.add("barreras", material, np.vstack([bottom, roof]), uv, faces, phys=collider)
+                footprints.append(footprint)
+                metres += run.intersection(footprint).length
+    return footprints, metres
+
+
+class _RoadSurface:
+    """Read the finished road mesh within an island's bounds and sample it barycentrically."""
+
+    def __init__(self, scene, surfaces=None):
+        self.pieces = [piece for (group, _, phys), pieces in scene.pieces.items()
+                       if group == "calzada" and phys and (surfaces is None or phys in surfaces)
+                       for piece in pieces]
+        boxes = [box(*piece.pos[:, :2].min(axis=0), *piece.pos[:, :2].max(axis=0)) for piece in self.pieces]
+        self.index = shapely.STRtree(boxes)
+
+    def sampler(self, footprint, terrain):
+        xmin, ymin, xmax, ymax = footprint.bounds
+        nearby = []
+        for idx in self.index.query(footprint):
+            piece = self.pieces[idx]
+            faces = piece.pos[piece.faces]
+            a, b = faces[:, :, :2].min(axis=1), faces[:, :, :2].max(axis=1)
+            hit = ((a[:, 0] <= xmax) & (a[:, 1] <= ymax) & (b[:, 0] >= xmin) & (b[:, 1] >= ymin))
+            nearby.append(faces[hit])
+        def ground_height(xy):
+            if terrain is None:
+                return np.full(len(xy), np.nan)
+            return terrain.height(*xy.T)
+
+        if not nearby:
+            return ground_height
+        triangles = np.concatenate(nearby)
+        a, b = triangles[:, 1] - triangles[:, 0], triangles[:, 2] - triangles[:, 0]
+        det = a[:, 0] * b[:, 1] - a[:, 1] * b[:, 0]
+        valid = np.abs(det) > 1e-10
+        origin, a, b, det = triangles[valid, 0], a[valid], b[valid], det[valid]
+        tree = shapely.STRtree(shapely.polygons(triangles[valid, :, :2]))
+
+        def height(xy):
+            above, tri = tree.query(shapely.points(xy), predicate="intersects")
+            ground = ground_height(xy)
+            if not len(tri):
+                return ground
+            delta = xy[above] - origin[tri, :2]
+            u = (delta[:, 0] * b[tri, 1] - delta[:, 1] * b[tri, 0]) / det[tri]
+            v = (a[tri, 0] * delta[:, 1] - a[tri, 1] * delta[:, 0]) / det[tri]
+            hit = origin[tri, 2] + u * a[tri, 2] + v * b[tri, 2]
+            level = np.full(len(xy), -np.inf)
+            np.maximum.at(level, above, hit)
+            return np.where(np.isfinite(level), level, ground)
+
+        return height
+
+
+def _remove_automatic_island(stock, footprint):
+    """Remove the stock mesh for the same island, including its full-height vertical kerb."""
+    for pieces, piece in stock:
+        if piece in pieces:
+            outline = shapely.MultiPoint(piece.pos[:, :2]).convex_hull
+            if outline.area and (outline.covers(footprint.centroid)
+                                 or footprint.intersection(outline).area > 0.5 * outline.area):
+                pieces.remove(piece)
+
+
+def _islands(scene, terrain, proj, zone, road_surface, stock, entry):
+    x, y = _xy(proj, entry["center"])
+    center = Point(x, y)
+    if not zone.covers(center):
+        return []
+    kind = entry.get("kind", "roundabout")
+    outlines = entry.get("islands")
+    if kind == "roundabout":
+        outer = _number(entry["outer_diameter_m"], 1, 200, "outer_diameter_m")
+        inner = _number(entry["inner_diameter_m"], 0.2, outer - 0.2, "inner_diameter_m")
+        outlines = outlines or [{"ring": None, "material": "grass"}]
+    elif kind != "island_junction" or not outlines or any(not item.get("ring") for item in outlines):
+        raise ValueError("provide surveyed island rings for a non-circular island junction")
+    specs = [(item, True) for item in outlines] + [(item, False) for item in entry.get("splitter_islands", [])]
+    outputs, plans = [], []
+    for item, central in specs:
+        ring = item["ring"]
+        if ring is None and central and kind == "roundabout":
+            footprint = center.buffer(inner / 2, quad_segs=20)
+        else:
+            footprint = Polygon([_xy(proj, point) for point in ring])
+        if not footprint.is_valid or footprint.area < 0.04:
+            raise ValueError("island ring must be a valid polygon")
+        if not zone.covers(footprint):
+            raise ValueError("island intersects the edge of the detailed zone")
+        if kind == "roundabout" and central and not center.buffer(outer / 2 + 0.01, quad_segs=40).covers(footprint):
+            raise ValueError("central island extends past the surveyed outer diameter")
+        height = _number(item.get("kerb_height_m", entry.get("kerb_height_m", 0.08)), 0, 0.08, "kerb_height_m")
+        width = _number(item.get("kerb_width_m", entry.get("kerb_width_m", 0.32)),
+                        max(0.05, 4 * height), 2.0, "kerb_width_m")
+        platform = footprint.buffer(-width, join_style="mitre")
+        if platform.is_empty:
+            raise ValueError("island is narrower than its sloped kerb")
+        mat = _material(scene, item.get("material", "grass"))
+        curb = _material(scene, item.get("kerb_material", "guarnicion"))
+        content = item.get("content", [])
+        if not isinstance(content, list) or not all(isinstance(name, str) and name for name in content):
+            raise ValueError("island content is a list of landmark IDs")
+        plans.append((footprint, platform, height, width, mat, curb, content))
+
+    if any(a[0].intersection(b[0]).area > 0.001 for i, a in enumerate(plans) for b in plans[:i]):
+        raise ValueError("island outlines overlap")
+    for footprint, platform, height, width, mat, curb, content in plans:
+        sample = road_surface.sampler(footprint, terrain)
+        edge = footprint.boundary
+
+        def surface(xy, sample=sample, edge=edge, height=height, width=width):
+            if height == 0:
+                return sample(xy) + 0.003
+            distance = shapely.distance(shapely.points(xy), edge)
+            lift = min(0.003, height / 2)
+            return sample(xy) + lift + (height - lift) * np.minimum(distance / width, 1.0)
+
+        _remove_automatic_island(stock, footprint)
+        for polygon, material, physics in ((footprint.difference(platform), curb, "PAVEMENT"),
+                                          (platform, mat, "GRASS" if mat == "isleta" else "PAVEMENT")):
+            for piece in iter_polys(polygon):
+                xy, faces = triangulate_polygon(piece, 0.30)
+                pos = np.column_stack([xy, surface(xy)])
+                scene.add("isleta", material, pos, xy / 2, _face_up(xy, faces), phys=physics if height else None)
+        outputs.append((footprint, surface, set(content)))
+    return outputs
+
+
+def _radial(kind):
+    count = 20
+    angles = np.arange(count) * (2 * np.pi / count)
+    ring = np.c_[np.cos(angles), np.sin(angles)] / 2
+    if kind == "ellipsoid":
+        latitude = np.linspace(-np.pi / 2, np.pi / 2, 11)[1:-1]
+        points = [np.c_[ring * np.cos(angle), np.full(count, np.sin(angle) / 2)] for angle in latitude]
+    else:
+        points = [np.c_[ring, np.full(count, -0.5)]]
+        if kind == "cylinder":
+            points.append(np.c_[ring, np.full(count, 0.5)])
+    pos = np.vstack([*points, (0, 0, -0.5), (0, 0, 0.5)])
+    i = np.arange(count)
+    nxt = (i + 1) % count
+    bands = []
+    for lower in range(0, (len(points) - 1) * count, count):
+        upper = lower + count
+        bands.extend([np.c_[lower + i, lower + nxt, upper + nxt],
+                      np.c_[lower + i, upper + nxt, upper + i]])
+    top = (len(points) - 1) * count
+    faces = np.vstack([np.c_[nxt, i, np.full(count, len(pos) - 2)],
+                       *bands, np.c_[top + i, top + nxt, np.full(count, len(pos) - 1)]])
+    uv = pos[:, (0, 2)] + 0.5
+    return pos, uv, faces
+
+
+def _model(directory, model):
+    if not isinstance(model, str):
+        raise ValueError("model must be a relative path to a JSON mesh")
+    path = (directory / model).resolve()
+    if not path.is_relative_to(directory.resolve()) or path.suffix.lower() != ".json":
+        raise ValueError("model must be a JSON mesh within the override directory")
+    if path.stat().st_size > 5_000_000:
+        raise ValueError("landmark mesh exceeds 5 MB")
+    data = json.loads(path.read_text(encoding="utf-8"))
+    if not isinstance(data, dict):
+        raise ValueError("model JSON must be an object")
+    vertices, faces = data["vertices"], data["faces"]
+    if not isinstance(vertices, list) or not 3 <= len(vertices) <= 65_000:
+        raise ValueError("model must have 3 to 65,000 vertices")
+    if not isinstance(faces, list) or not 1 <= len(faces) <= 100_000:
+        raise ValueError("model must have 1 to 100,000 triangle faces")
+    pos = np.array([_vector(vertex, 3, -1, 1, "model vertex") for vertex in vertices])
+    if (pos[:, :2] < -0.5).any() or (pos[:, :2] > 0.5).any() or (pos[:, 2] < 0).any():
+        raise ValueError("model x, y must be in [-0.5, 0.5] and relative z in [0, 1]")
+    tri = np.asarray(faces)
+    if (tri.shape != (len(faces), 3) or not np.issubdtype(tri.dtype, np.integer)
+            or (tri < 0).any() or (tri >= len(pos)).any()):
+        raise ValueError("model faces must be triangles with valid zero-based vertex indices")
+    uv = data.get("uv")
+    if uv is None:
+        uv = pos[:, (0, 2)] + (0.5, 0.0)
+    elif isinstance(uv, list) and len(uv) == len(pos):
+        uv = np.array([_vector(item, 2, -1000, 1000, "model UV") for item in uv])
+    else:
+        raise ValueError("model UVs must match the vertex count")
+    return pos, uv, tri
+
+
+def _shape(scene, shape, dimensions):
+    parts = shape["parts"]
+    if not isinstance(parts, list) or not 1 <= len(parts) <= 128:
+        raise ValueError("shape requires 1 to 128 parts")
+    meshes = []
+    for part in parts:
+        center = _vector(part["center"], 3, -1, 1, "part center")
+        if center[2] < 0:
+            raise ValueError("part center height is relative to the base")
+        size = _vector(part["size"], 3, 0.001, 1, "part size")
+        orientation = _vector(part.get("rotation_deg", [0, 0, 0]), 3, -360, 360, "rotation_deg")
+        kind = part["kind"]
+        if kind == "box":
+            pos, uv, faces = box_mesh((0, 0, -0.5), (1, 1, 1))
+            bottom = np.array([[-0.5, -0.5, -0.5], [-0.5, 0.5, -0.5],
+                               [0.5, 0.5, -0.5], [0.5, -0.5, -0.5]])
+            faces = np.vstack([faces, np.array([[0, 1, 2], [0, 2, 3]]) + len(pos)])
+            uv = np.vstack([uv, bottom[:, :2] + 0.5])
+            pos = np.vstack([pos, bottom])
+        elif kind in ("cylinder", "ellipsoid", "cone"):
+            pos, uv, faces = _radial(kind)
+        else:
+            raise ValueError(f"unsupported landmark part {kind!r}")
+        # Rotation is applied to the part about its centre before translation.
+        material = _material(scene, part.get("material", "limestone"))
+        rotation = Rotation.from_euler("xyz", orientation, degrees=True)
+        meshes.append((material, rotation.apply(pos * size * dimensions) + center * dimensions, uv, faces))
+    return meshes
+
+
+def _landmark(scene, terrain, proj, zone, directory, entry, islands, road_surface):
+    x, y = _xy(proj, [entry["lat"], entry["lon"]])
+    point = Point(x, y)
+    if not zone.covers(point):
+        return None
+    size = _vector(entry["size_m"], 3, 0.05, 80, "size_m")
+    heading = _number(entry.get("heading_deg", 0), -360, 360, "heading_deg")
+    collider = _collider(entry)
+    if ("model" in entry) == ("shape" in entry):
+        raise ValueError("provide either model or shape")
+    if "model" in entry:
+        pos, uv, faces = _model(directory, entry["model"])
+        parts = [(_material(scene, entry.get("material", "limestone")), pos * size, uv, faces)]
+    else:
+        parts = _shape(scene, entry["shape"], size)
+    reference = entry.get("anchor", "auto")
+    if reference not in ("auto", "terrain", "road"):
+        raise ValueError("anchor must be auto, terrain, or road")
+    xy = np.array([[x, y]])
+    if reference == "road":
+        base = float(road_surface.sampler(point, terrain)(xy)[0])
+    else:
+        base = float(terrain.height(*xy.T)[0])
+    for footprint, sample, content in islands:
+        if entry["id"] in content and not footprint.covers(point):
+            raise ValueError("landmark lies outside the island that lists it")
