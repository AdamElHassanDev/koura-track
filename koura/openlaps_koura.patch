+def build_background(scene, buildings, ground_height, log=print):
+    """Add low-cost footprint shells outside the detailed scenery area."""
+    from PIL import Image
+
+    colours = np.asarray(active().facade_colors[:4])
+    walls = [f"fachada_fondo_{i}" for i in range(len(colours))]
+    for name, colour in zip(walls, colours):
+        texture = f"{name}.png"
+        image = Image.new("RGB", (4, 4), tuple(int(c) for c in colour))
+        scene.textures[texture] = textures.png(image)
+        scene.images[texture] = image
+        scene.material(name, texture, specular=0.0, shadows=False)
+
+    count = 0
+    for building in buildings:
+        footprint = building["poly"].simplify(0.4)
+        if footprint.geom_type != "Polygon" or footprint.area < 6.0:
+            continue
+        footprint = shapely.geometry.polygon.orient(footprint, 1.0)
+        xy = np.asarray(footprint.exterior.coords)[:, :2]
+        levels = ground_height(*xy.T)
+        base = float(np.min(levels)) - 1.0
+        roof = float(np.median(levels)) + height_of(building, True)
+        colour = textures.parse_colour(building["tags"].get("building:colour"))
+        if colour:
+            variant = int(np.argmin(np.linalg.norm(colours - colour, axis=1)))
+        else:
+            variant = min(len(walls) - 1, int(_h(footprint.centroid.wkt) * len(walls)))
+        for boundary in (footprint.exterior, *footprint.interiors):
+            xy = np.asarray(boundary.coords)[:, :2]
+            bot = np.column_stack([xy, np.full(len(xy), base)])
+            pos, uv, faces = wall_strip(bot, roof - base, both=False)
+            scene.add("edificios_fondo", walls[variant], pos, uv, faces)
+        xy, faces = triangulate_polygon(footprint, 50.0)
+        if len(faces):
+            pos = np.column_stack([xy, np.full(len(xy), roof)])
+            scene.add("edificios_fondo", "azotea_concreto", pos, xy / 4.0, faces)
