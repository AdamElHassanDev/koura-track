+def _place_spawns(scene, net, spawns, log=print):
+    """Preview: one AC_PIT_i / AC_START_i per spawn point (local x, y), on the nearest built road run >= 40 m."""
+    cands = []
+    for e in net.edges:
+        if e.tunnel or e.bridge:
+            continue
+        for a, b in net.ranges(e):
+            if b - a < 40:
+                continue
+            sv = np.arange(a + 6, b - 6, 4.0)
+            if len(sv) == 0:
+                continue
+            cands.append((e, a, b, sv, e.at(sv, 0.0)))
+    for i, (x, y) in enumerate(spawns):
+        best, bd = None, 1e18
+        for e, a, b, sv, P in cands:
+            d = np.hypot(P[:, 0] - x, P[:, 1] - y)
+            j = int(np.argmin(d))
+            if d[j] < bd:
+                best, bd = (e, a, b, float(sv[j])), float(d[j])
+        e, a, b, s0 = best
+        sv = np.arange(max(a + 1, s0 - 20), min(b - 1, s0 + 20), 1.0)
+        poly = e.at(sv, 0.0)
+        k = len(poly) // 2
+        t, n = _frame(poly, k)
+        pos = poly[k].copy()
+        pos[2] += 0.3
+        scene.dummy(f"AC_PIT_{i}", pos, t)
+        scene.dummy(f"AC_START_{i}", pos, t)
+        if i == 0:
+            scene.dummy("AC_HOTLAP_START_0", pos, t)
+            for side, nm in ((1, "AC_TIME_0_L"), (-1, "AC_TIME_0_R")):
+                scene.dummy(nm, poly[k] + np.r_[n * side * (e.hw + 1), 0.5], t)
+        log(f"  salida {i}: a {bd:.0f} m del punto pedido, en {e.tags.get('name', e.cls)}")
+
+
